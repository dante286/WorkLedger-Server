@page
@model WorkLedger.Server.Pages.Portal.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}
<section class="card narrow">
    <h1>Sign out</h1>
    <p>This signs this browser out of the portal. Your desktop apps stay signed in.</p>
    <form method="post">
        <button type="submit" class="primary">Sign out</button>
    </form>
</section>
