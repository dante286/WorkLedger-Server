@page
@model WorkLedger.Server.Pages.Portal.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="card narrow">
    <h1>Sign in</h1>
    <p class="muted">Manage your WorkLedger account. Your time is tracked in the desktop app.</p>

    @if (Model.Error is not null)
    {
        <p class="alert" role="alert">@Model.Error</p>
    }

    <form method="post">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
        <label for="email">Email</label>
        <input id="email" name="Email" type="email" value="@Model.Email" autocomplete="username" required autofocus>
        <label for="password">Password</label>
        <input id="password" name="Password" type="password" autocomplete="current-password" required>
        <button type="submit" class="primary">Sign in</button>
    </form>
</section>
