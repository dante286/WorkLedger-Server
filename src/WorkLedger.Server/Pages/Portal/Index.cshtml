@page
@model WorkLedger.Server.Pages.Portal.IndexModel
@{
    ViewData["Title"] = "Your account";
}
<partial name="_AccountNav" />

@if (Model.Welcome)
{
    <p class="notice" role="status">Your account is ready. Now sign in to the desktop app with it — details below.</p>
}
<section class="card">
    <h1>Your account</h1>
    <dl class="facts">
        <dt>Email</dt>
        <dd>@Model.Email</dd>
        @if (Model.DisplayName is not null)
        {
            <dt>Name</dt>
            <dd>@Model.DisplayName</dd>
        }
        <dt>Member since</dt>
        <dd>@PortalFormat.Time(Model.CreatedAt)</dd>
    </dl>
</section>

@if (User.HasClaim(WorkLedger.Server.Auth.TokenRevocation.AdminClaim, "true"))
{
    <section class="card">
        <h2>Administration</h2>
        <p>You are an administrator of this server. <a href="/portal/admin">Manage users and invites</a>.</p>
    </section>
}

<section class="card">
    <h2>Desktop app</h2>
    <p>To sync your time with this server, sign in to the WorkLedger desktop app with your email and password, using this server address:</p>
    <div class="copy-row">
        <input id="server-address" class="server-address" type="text" readonly value="@Model.ServerAddress" aria-label="Server address">
        <button type="button" class="secondary" data-copy="server-address" hidden>Copy</button>
    </div>
</section>
