<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WorkLedger.Contracts\WorkLedger.Contracts.csproj" />
  </ItemGroup>

  <!-- EF Core moves in lockstep with the ASP.NET packages. DataProtection.EntityFrameworkCore (S11's
       persisted key ring) requires EF Core >= its own version, and it pulls System.Security.Cryptography.Xml
       at its own version - which NU1903 has flagged twice: at 10.0.4, and at 10.0.10 (CVE-2026-96958/9/60,
       fixed in 10.0.13; WL-232). So everything is on 10.0.14 rather than one package left behind. The
       server itself runs the shared framework's copy (the Web SDK prunes the package), so the runtime image
       has to be current too; the test project restores the package, which is where the warning shows. Relational is referenced directly only so Npgsql's older minimum cannot pull a second
       copy into the test project (MSB3277); drop it once Npgsql's own dependency catches up. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- S12's SMTP transport. MailKit rather than System.Net.Mail.SmtpClient, which Microsoft marks "not
       recommended for new development"; managed code with no native dependency, so the Alpine image
       needs nothing extra. Checked with the NuGet vulnerability audit (dotnet list package with vulnerable and include-transitive). -->
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
