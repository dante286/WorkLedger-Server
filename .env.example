# Copy to .env (git-ignored) and fill in. `docker compose up` reads it automatically; the compose
# file fails the up with the variable's name if a required one is missing, so there is no way to
# accidentally boot with a default secret.

# --- Secrets. Generate real ones; do not ship these strings. -----------------------------------
# openssl rand -base64 48   (or: pwsh -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))")
# Signs the device JWTs. Must be at least 32 bytes — the API refuses to start otherwise. Rotating it
# invalidates every token already issued; recovery is that each device signs in again, which is a
# sign-in prompt rather than an operator errand. It is not in the database, so back it up
# (encrypted) alongside your dumps.
Jwt__SigningKey=CHANGE-ME-at-least-32-bytes-of-random-base64

# Never a token: POST /auth/login and a password are the only things that mint one. This is the
# *operator* credential, wanted in the X-Bootstrap-Secret header by exactly three routes —
# POST /auth/register, POST /auth/claim and POST /admin/bootstrap. Treat it like a password.
#
# DO NOT HAND IT TO A COLLEAGUE TO SIGN UP WITH. It cannot be scoped to one person, expired,
# revoked or audited, and whoever holds it holds it forever. Issue them an invite instead
# (POST /admin/invites), then set Auth__SignupSecretEnabled=false below so the secret is out of the
# signup path altogether. See "Running this for more than one person" in README.md.
#
# REGISTRATIONS_ALLOWED=false (below) closes signup outright, invites included. /auth/claim
# deliberately ignores both flags so an operator can always take ownership of pre-existing data.
Bootstrap__Secret=CHANGE-ME-random-string

# Postgres superuser password for the bundled database container. Set before the first `up`:
# it is baked into the volume by initdb, and changing it afterwards needs an ALTER USER, not an edit
# here.
POSTGRES_PASSWORD=CHANGE-ME-random-string

# --- Optional. Defaults in docker-compose.yml are fine for a single-user deployment. -------------
# POSTGRES_DB=workledger
# POSTGRES_USER=workledger

# Full connection string for an external/managed Postgres. Set this and the POSTGRES_* variables
# above are ignored by the API (the postgres container still uses them, so also stop that service).
# ConnectionStrings__Postgres=Host=db.example.com;Port=5432;Database=workledger;Username=workledger;Password=...;SSL Mode=Require

# --- Optional: account policy. GET /auth/capabilities reports these, so a client renders the truth
# --- about your server instead of guessing at it. Everything here is configuration, not a secret.
# Whether POST /auth/register accepts signups at all (403 when off). REGISTRATIONS_ALLOWED is the
# flat alias operators reach for; Auth__RegistrationEnabled is canonical and wins if both are set.
# POST /auth/claim is not gated by this — see the Bootstrap__Secret note above.
# REGISTRATIONS_ALLOWED=true

# Whether X-Bootstrap-Secret still satisfies POST /auth/register. Set false and an invite becomes
# the only way to create an account — which is the point of invites rather than an optional extra,
# because while this is on, anyone ever given the secret can still sign themselves up. It defaults
# on so that upgrading changes nothing before you have issued anything. /auth/claim and
# POST /admin/bootstrap are unaffected. SIGNUP_SECRET_ENABLED is the flat alias; this key wins.
# Auth__SignupSecretEnabled=true

# How long an invite lasts when the admin issuing it does not choose (expiresInDays on the request
# overrides it per invite). There is deliberately no value meaning "never": an invite that cannot
# expire is a standing credential, which is the thing invites exist to stop being.
# Auth__InviteExpiryDays=14

# How long an admin-issued password-reset token lasts. Hours where an invite gets days, on purpose
# — an invite is arranged in advance, a reset is handed over during a conversation happening now.
# Auth__PasswordResetExpiryHours=24

# Shortest password /auth/register, /auth/claim, /auth/password and /auth/password/reset accept.
# Auth__MinPasswordLength=12

# Per-account lockout: this many consecutive failed sign-ins locks the account for
# Auth__LockoutMinutes, answered as 423 with a Retry-After. The counter resets once the window
# expires, so an account cannot end up locked forever. Set Auth__MaxFailedLogins=0 to switch the
# lockout off entirely.
# Auth__MaxFailedLogins=5
# Auth__LockoutMinutes=15

# Per-IP rate limit on the credential endpoints (/auth/register, /auth/claim, /auth/login,
# /auth/password/reset); over it is a 429 with Retry-After, and 0 disables it. This defends the box
# against someone spraying many addresses, where the lockout above defends one account.
# Which address it counts against is Network__TrustedProxies, below.
# Auth__LoginRateLimitPerMinute=10

# --- Optional: reverse proxy. -------------------------------------------------------------------
# The reverse proxies whose X-Forwarded-For this deployment believes, comma-separated; addresses
# and CIDR blocks both work (10.0.0.0/24, 2001:db8::/32). Give the proxy's address ON THE NETWORK
# THE API SEES, not its public one.
#
# UNSET IS THE DEFAULT AND MEANS TODAY'S BEHAVIOUR EXACTLY: no forwarded-header processing at all,
# and the rate limit above partitions on the socket address — which behind a proxy is the proxy, so
# the whole deployment shares one bucket. Set this and each caller behind the named hop gets their
# own.
#
# ONLY LIST HOPS YOU CONTROL. X-Forwarded-For is caller-supplied, so trusting it from an untrusted
# hop is worse than one shared bucket: anyone could invent an address per request and hand
# themselves an unlimited one. There is no wildcard, and a value that cannot be parsed stops the
# container at startup naming it — a silently skipped typo would look exactly like configuring
# nothing. The API logs which of the two modes it is in on every boot.
# Network__TrustedProxies=172.18.0.5

# How long an authenticated request's revocation check is cached, in seconds. This is the revocation
# lag: removing a device, changing a password or signing out everywhere takes effect within this
# window at worst, and immediately in the common case because those endpoints evict the entry
# themselves. 0 disables the cache and checks the database on every authenticated request.
# Auth__StampCacheSeconds=30

# Device token lifetime. There is no refresh or rotation — revocation is the security stamp above,
# not expiry — so this is long by default.
# Jwt__ExpiryDays=365

# Host port and bind address for the API. Use API_BIND=127.0.0.1 when a reverse proxy on the same
# host is the only thing that should reach it.
# API_PORT=8080
# API_BIND=0.0.0.0

# Image tag to run, and the version stamped into the build (GET / reports it).
# WORKLEDGER_VERSION=0.1.0
